#!/bin/bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2025 Rosalia Labs LLC

set -euo pipefail

SCRIPT_FILE="$(realpath "${BASH_SOURCE[0]}")"
resolve_overlay_root() {
    printf '%s\n' "${SENSOS_CLIENT_ROOT:-/sensos}"
}

OVERLAY_ROOT="$(resolve_overlay_root)"
CLIENT_ROOT="${SENSOS_CLIENT_ROOT:-${OVERLAY_ROOT}}"
script_name="$(basename "$0")"
PARSE_SWITCHES_LIB="${OVERLAY_ROOT}/libexec/parse-switches.sh"
SENSOS_ADMIN_HELPER_LIB="${OVERLAY_ROOT}/libexec/ensure-sensos-admin.sh"

[[ -f "${PARSE_SWITCHES_LIB}" ]] || {
    echo "Missing parse-switches library at ${PARSE_SWITCHES_LIB}"
    exit 1
}
source "${PARSE_SWITCHES_LIB}"
[[ -f "${SENSOS_ADMIN_HELPER_LIB}" ]] || {
    echo "Missing sensos-admin helper at ${SENSOS_ADMIN_HELPER_LIB}" >&2
    exit 1
}
source "${SENSOS_ADMIN_HELPER_LIB}"

ensure_sensos_admin_user "${SCRIPT_FILE}" "$@"

config_path="${CLIENT_ROOT}/etc/birdweather-uploads.conf"
token_path="${CLIENT_ROOT}/keys/birdweather_token"
mkdir -p "${CLIENT_ROOT}/etc"

register_option --station-token station_token "BirdWeather station auth token (from app.birdweather.com); required to enable uploads" ""
register_option --session-interval-sec session_interval_sec "Seconds to idle between checks once caught up" "1800"
register_option --connect-timeout-sec connect_timeout_sec "HTTP connect timeout (seconds)" "10"
register_option --read-timeout-sec read_timeout_sec "HTTP read timeout (seconds)" "60"
register_option --upload-audio upload_audio "Also upload the detection's audio clip (BirdWeather 'soundscape'); shares more data per detection" "false"
register_option --upload-min-score upload_min_score "Skip uploading to BirdWeather (but keep locally / still upload to sensos-server) detections scored below this (0-1, 0=disabled)" "0.0"
register_option --upload-min-likelihood upload_min_likelihood "Skip uploading to BirdWeather detections below this location/date likelihood (0-1, 0=disabled)" "0.0"
register_option --upload-min-volume upload_min_volume "Skip uploading to BirdWeather detections below this normalized volume (0-1, 0=disabled)" "0.0"
register_option --upload-min-score-x-likelihood upload_min_score_x_likelihood "Skip uploading to BirdWeather detections whose score*likelihood is below this (0-1, 0=disabled)" "0.0"
register_option --enable-service enable_service "Enable systemd service" "true"
register_option --start-service start_service "Start systemd service" "false"
register_option --disable disable_service "Disable and stop systemd service" "false"

parse_switches "$script_name" "$@"

# Only --start-service is checked here: --enable-service defaults to "true"
# even when never passed on the command line, so checking it here would
# make plain `config-birdweather --disable` (no other flags) falsely refuse
# to run against its own default. --disable always wins over a leftover
# default enable_service value -- see the enable branch below, which is
# skipped whenever disable_service is set, regardless of enable_service.
if [[ "$disable_service" == "true" && "$start_service" == "true" ]]; then
    echo "--disable cannot be combined with --start-service"
    exit 1
fi

if [[ "$disable_service" != "true" && -z "$station_token" && ! -f "$token_path" ]]; then
    cat >&2 <<EOF
ERROR: --station-token is required the first time BirdWeather uploads are configured.

Uploading to BirdWeather is entirely optional and shares this device's bird
detections (and, if --upload-audio is set, short audio clips) publicly with
BirdWeather (birdweather.com). Get a station token by creating a station at
https://app.birdweather.com, then run:

  config-birdweather --station-token '<token>' --start-service

To turn uploads off again later: config-birdweather --disable
EOF
    exit 1
fi

{
    echo "# Auto-generated by $script_name"
    echo "SESSION_INTERVAL_SEC=${session_interval_sec}"
    echo "CONNECT_TIMEOUT_SEC=${connect_timeout_sec}"
    echo "READ_TIMEOUT_SEC=${read_timeout_sec}"
    echo "UPLOAD_AUDIO=${upload_audio}"
    echo "# Upload-side filtering only -- detections that don't meet these"
    echo "# stay in the local database untouched and still upload to"
    echo "# sensos-server normally; they just never get sent to BirdWeather."
    echo "UPLOAD_MIN_SCORE=${upload_min_score}"
    echo "UPLOAD_MIN_LIKELIHOOD=${upload_min_likelihood}"
    echo "UPLOAD_MIN_VOLUME=${upload_min_volume}"
    echo "UPLOAD_MIN_SCORE_X_LIKELIHOOD=${upload_min_score_x_likelihood}"
} >"${config_path}"

echo "Wrote config to ${config_path}:"
cat "${config_path}"

if [[ -n "$station_token" ]]; then
    sudo install -D -m 0600 /dev/null "${token_path}"
    printf '%s' "$station_token" | sudo tee "${token_path}" >/dev/null
    sudo chown sensos-admin:sensos-admin "${token_path}"
    sudo chmod 0600 "${token_path}"
    echo "Wrote BirdWeather station token to ${token_path}."
fi

sudo systemctl daemon-reload

if [[ "$disable_service" == "true" ]]; then
    echo "Disabling sensos-upload-birdweather.service..."
    sudo systemctl disable --now sensos-upload-birdweather.service || true
fi

if [[ "$enable_service" == "true" && "$disable_service" != "true" ]]; then
    echo "Enabling sensos-upload-birdweather.service..."
    sudo systemctl enable sensos-upload-birdweather.service
    if sudo systemctl is-active --quiet sensos-upload-birdweather.service; then
        echo "Restarting sensos-upload-birdweather.service to apply new settings..."
        sudo systemctl restart sensos-upload-birdweather.service
    fi
fi

if [[ "$start_service" == "true" ]]; then
    echo "Starting sensos-upload-birdweather.service..."
    sudo systemctl start sensos-upload-birdweather.service
fi
