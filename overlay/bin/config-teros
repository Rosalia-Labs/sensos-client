#!/bin/bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Rosalia Labs LLC

set -e

SCRIPT_FILE="$(realpath "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_FILE}")" && pwd)"
resolve_overlay_root() {
    printf '%s\n' "${SENSOS_CLIENT_ROOT:-/sensos}"
}

OVERLAY_ROOT="$(resolve_overlay_root)"
CLIENT_ROOT="${SENSOS_CLIENT_ROOT:-${OVERLAY_ROOT}}"

script_name=$(basename "$0")
PARSE_SWITCHES_LIB="${OVERLAY_ROOT}/libexec/parse-switches.sh"
SENSOS_ADMIN_HELPER_LIB="${OVERLAY_ROOT}/libexec/ensure-sensos-admin.sh"

[[ -f "${PARSE_SWITCHES_LIB}" ]] || {
    echo "Missing parse-switches library at ${PARSE_SWITCHES_LIB}"
    exit 1
}
source "${PARSE_SWITCHES_LIB}"
[[ -f "${SENSOS_ADMIN_HELPER_LIB}" ]] || {
    echo "Missing sensos-admin helper at ${SENSOS_ADMIN_HELPER_LIB}" >&2
    exit 1
}
source "${SENSOS_ADMIN_HELPER_LIB}"

ensure_sensos_admin_user "${SCRIPT_FILE}" "$@"

config_path="${CLIENT_ROOT}/etc/teros.conf"
mkdir -p "${CLIENT_ROOT}/etc"

register_option --device device "Serial device of the TEROS 12 USB node (e.g. /dev/teros-node-0); empty means autodetect /dev/serial/by-id, then /dev/ttyACM*, then /dev/ttyUSB*" ""
register_option --interval interval "Polling interval for every probe on the node (seconds)" "300"
register_option --subsamples subsamples "Number of evenly spaced subsamples per interval to average" "5"
register_option --enable-service enable_service "Enable systemd service" "true"
register_option --start-service start_service "Start systemd service" "false"
register_option --disable disable_service "Disable and stop systemd service" "false"

parse_switches "$script_name" "$@"

# Only --start-service is checked here: --enable-service defaults to "true"
# even when never passed on the command line, so checking it here would
# make plain `config-teros --disable` (no other flags) falsely refuse to run
# against its own default. --disable always wins over a leftover default
# enable_service value -- see the enable branch below, which is skipped
# whenever disable_service is set, regardless of enable_service.
if [[ "$disable_service" == "true" && "$start_service" == "true" ]]; then
    echo "--disable cannot be combined with --start-service"
    exit 1
fi

resolved_device="$device"
if [[ -z "$resolved_device" && "$disable_service" != "true" ]]; then
    for pattern in /dev/serial/by-id/* /dev/ttyACM* /dev/ttyUSB*; do
        [[ -e "$pattern" ]] || continue
        resolved_device="$pattern"
        break
    done
    if [[ -z "$resolved_device" ]]; then
        echo "ERROR: no serial device found for the TEROS node (/dev/serial/by-id/*, /dev/ttyACM*, /dev/ttyUSB*)." >&2
        echo "Pass --device explicitly, or plug in the node and retry." >&2
        exit 1
    fi
fi

{
    echo "# Auto-generated by $script_name"
    [[ -n "$resolved_device" ]] && echo "TEROS_DEVICE=$resolved_device"
    [[ -n "$interval" ]] && echo "TEROS_INTERVAL_SEC=$interval"
    [[ -n "$subsamples" ]] && echo "SUBSAMPLES_PER_INTERVAL=$subsamples"
} >"$config_path"

echo "Wrote config to $config_path:"
cat "$config_path"
record_config_change "${SCRIPT_FILE}"

if [[ -n "$resolved_device" ]]; then
    teros_rules_src="${OVERLAY_ROOT}/etc/99-sensos-teros.rules"
    if [[ -f "${teros_rules_src}" ]]; then
        echo "Installing TEROS udev rule..."
        sudo install -m 0644 "${teros_rules_src}" /etc/udev/rules.d/99-sensos-teros.rules
        sudo udevadm control --reload-rules
    fi
fi

output_dir="${CLIENT_ROOT}/data/microenv"
sudo install -d -m 2775 -o sensos-runner -g sensos-data "${output_dir}"

echo "Verifying TEROS Python dependencies are provisioned..."
sudo "${CLIENT_ROOT}/libexec/setup-teros-python.sh" --verify-only

sudo systemctl daemon-reload
if [[ "$disable_service" == "true" ]]; then
    echo "Disabling sensos-read-teros.service..."
    sudo systemctl disable --now sensos-read-teros.service || true
fi

if [[ "$enable_service" == "true" && "$disable_service" != "true" ]]; then
    echo "Enabling sensos-read-teros.service..."
    sudo systemctl enable sensos-read-teros.service
fi

if [[ "$start_service" == "true" ]]; then
    echo "Starting sensos-read-teros.service..."
    sudo systemctl start sensos-read-teros.service
fi
