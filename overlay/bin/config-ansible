#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# Schedules ansible-pull (sensos-ansible-pull.timer + apply-ansible-pull.sh)
# to periodically pull and apply a playbook from a git repo. Runs as root
# (the standard way to run ansible-pull, since playbooks usually need to
# manage system state directly) and re-applies every tick rather than only
# on repo changes -- the playbook is expected to be idempotent, so this
# also corrects drift from anything else touching the system, the same
# reconciliation philosophy as config-uplink-cap.
#
# Auth to the git host reuses the sensos-admin SSH key (the same keypair
# config-network registers with sensos-server) instead of minting a
# second, root-owned key -- one key to add as a deploy key and rotate, not
# two. If that key doesn't exist yet, this generates it and prints the
# public half for you to paste into your git host.

set -euo pipefail

SCRIPT_FILE="$(realpath "${BASH_SOURCE[0]}")"
resolve_overlay_root() {
    printf '%s\n' "${SENSOS_CLIENT_ROOT:-/sensos}"
}

OVERLAY_ROOT="$(resolve_overlay_root)"
CLIENT_ROOT="${SENSOS_CLIENT_ROOT:-${OVERLAY_ROOT}}"
script_name="$(basename "$0")"
PARSE_SWITCHES_LIB="${OVERLAY_ROOT}/libexec/parse-switches.sh"
SENSOS_ADMIN_HELPER_LIB="${OVERLAY_ROOT}/libexec/ensure-sensos-admin.sh"

[[ -f "${PARSE_SWITCHES_LIB}" ]] || {
    echo "Missing parse-switches library at ${PARSE_SWITCHES_LIB}" >&2
    exit 1
}
source "${PARSE_SWITCHES_LIB}"
[[ -f "${SENSOS_ADMIN_HELPER_LIB}" ]] || {
    echo "Missing sensos-admin helper at ${SENSOS_ADMIN_HELPER_LIB}" >&2
    exit 1
}
source "${SENSOS_ADMIN_HELPER_LIB}"

ensure_sensos_admin_user "${SCRIPT_FILE}" "$@"

config_path="${CLIENT_ROOT}/etc/ansible.conf"
mkdir -p "${CLIENT_ROOT}/etc"

TIMER_NAME="sensos-ansible-pull.timer"
DROPIN_DIR="/etc/systemd/system/${TIMER_NAME}.d"
DROPIN_PATH="${DROPIN_DIR}/10-sensos-interval.conf"
SSH_PRIVATE_KEY="/home/sensos-admin/.ssh/id_ed25519"
SSH_PUBLIC_KEY="${SSH_PRIVATE_KEY}.pub"

register_option --repo-url repo_url "Git URL of the repo containing the playbook (ssh or https)" ""
register_option --branch branch "Git branch/tag/commit to checkout (default: repo's default branch)" ""
register_option --playbook playbook "Playbook file to run from the repo" "local.yml"
register_option --inventory inventory "Inventory path/pattern within the repo (default: localhost only)" ""
register_option --interval-sec interval_sec "Seconds between ansible-pull runs" "1800"
register_option --disable disable "Disable ansible-pull scheduling" "false"

parse_switches "$script_name" "$@"

print_public_key() {
    if [[ -f "${SSH_PUBLIC_KEY}" ]]; then
        echo
        echo "SSH public key for this device -- add it as a deploy key on your git host"
        echo "if it isn't already (e.g. GitHub repo -> Settings -> Deploy keys):"
        cat "${SSH_PUBLIC_KEY}"
    fi
}

if [[ "${disable}" == "true" ]]; then
    echo "Disabling ansible-pull scheduling..."
    rm -f "${config_path}"
    sudo rm -f "${DROPIN_PATH}"
    sudo systemctl disable --now "${TIMER_NAME}" 2>/dev/null || true
    record_config_change "${SCRIPT_FILE}"
    echo "Done."
    exit 0
fi

[[ -n "${repo_url}" ]] || {
    echo "ERROR: --repo-url is required." >&2
    exit 1
}

if [[ ! "${interval_sec}" =~ ^[0-9]+$ ]] || ((interval_sec < 60)); then
    echo "ERROR: --interval-sec must be an integer >= 60." >&2
    exit 1
fi

if [[ -f "${SSH_PRIVATE_KEY}" ]]; then
    echo "Using existing sensos-admin SSH key at ${SSH_PRIVATE_KEY}"
    echo "(the same key config-network registers with sensos-server)."
else
    echo "No existing sensos-admin SSH key found; generating one..."
    sudo install -d -m 700 -o sensos-admin -g sensos-admin "$(dirname "${SSH_PRIVATE_KEY}")"
    sudo ssh-keygen -t ed25519 -f "${SSH_PRIVATE_KEY}" -q -N ''
    sudo chown sensos-admin:sensos-admin "${SSH_PRIVATE_KEY}" "${SSH_PUBLIC_KEY}"
    sudo chmod 600 "${SSH_PRIVATE_KEY}"
    sudo chmod 644 "${SSH_PUBLIC_KEY}"
fi

{
    echo "# Auto-generated by ${script_name}"
    echo "ANSIBLE_REPO_URL=${repo_url}"
    [[ -n "${branch}" ]] && echo "ANSIBLE_BRANCH=${branch}"
    echo "ANSIBLE_PLAYBOOK=${playbook}"
    [[ -n "${inventory}" ]] && echo "ANSIBLE_INVENTORY=${inventory}"
} >"${config_path}"

echo "Wrote config to ${config_path}:"
cat "${config_path}"
record_config_change "${SCRIPT_FILE}"

sudo install -d -m 0755 "${DROPIN_DIR}"
tmp_dropin="$(mktemp)"
cat >"${tmp_dropin}" <<EOF
[Timer]
OnUnitActiveSec=${interval_sec}
EOF
sudo install -m 0644 "${tmp_dropin}" "${DROPIN_PATH}"
rm -f "${tmp_dropin}"

sudo systemctl daemon-reload
sudo systemctl enable --now "${TIMER_NAME}"

print_public_key

echo
echo "Done. ${TIMER_NAME} will re-check every ${interval_sec}s."
