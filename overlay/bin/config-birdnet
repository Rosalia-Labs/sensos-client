#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# Copyright (c) 2025 Rosalia Labs LLC

import argparse
import importlib.util
import math
import os
import subprocess
import sys
from pathlib import Path

CLIENT_ROOT = Path(os.environ.get("SENSOS_CLIENT_ROOT", "/sensos"))
UTILS_FILE = CLIENT_ROOT / "libexec" / "utils.py"
CONFIG_FILE = CLIENT_ROOT / "etc" / "birdnet.env"
MODEL_ROOT = CLIENT_ROOT / "birdnet" / "BirdNET_v2.4_tflite"
SERVICE_NAME = "sensos-birdnet.service"
SETUP_HELPER = CLIENT_ROOT / "libexec" / "setup-birdnet.sh"
DEFAULT_BACKEND = "litert"
DEFAULT_INPUT_MODE = "split-channels"
DEFAULT_MIC_POSITIONS_CM = "0,200;200,0;0,-200;-200,0"
BACKEND_ALIASES = {
    "tensorflow": "tensorflow",
    "litert": "litert",
    "tflite": "litert",
}
INPUT_MODE_CHOICES = ("mono", "split-channels", "cardinal-beams")

if not UTILS_FILE.is_file():
    raise RuntimeError(f"Missing utils.py at {UTILS_FILE}")

UTILS_SPEC = importlib.util.spec_from_file_location("sensos_overlay_utils", UTILS_FILE)
UTILS_MODULE = importlib.util.module_from_spec(UTILS_SPEC)
assert UTILS_SPEC.loader is not None
UTILS_SPEC.loader.exec_module(UTILS_MODULE)

ensure_sensos_admin = UTILS_MODULE.ensure_sensos_admin


def run(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, capture_output=True)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Configure optional host-native BirdNET processing."
    )
    parser.add_argument(
        "--disable",
        action="store_true",
        help="Disable BirdNET processing and stop the systemd service.",
    )
    parser.add_argument(
        "--enable-service",
        action="store_true",
        default=True,
        help="Enable sensos-birdnet.service after setup (default: true).",
    )
    parser.add_argument(
        "--start-service",
        action="store_true",
        help="Start sensos-birdnet.service after setup.",
    )
    parser.add_argument(
        "--backend",
        choices=["tensorflow", "litert", "tflite"],
        default=DEFAULT_BACKEND,
        help="BirdNET inference backend to install and require (default: litert).",
    )
    parser.add_argument(
        "--input-mode",
        choices=INPUT_MODE_CHOICES,
        default=DEFAULT_INPUT_MODE,
        help="How BirdNET should treat multichannel audio (default: split-channels).",
    )
    parser.add_argument(
        "--mic-positions-cm",
        default=None,
        help=(
            "Four device-relative microphone x,y positions in centimeters, "
            "formatted as 'x,y;x,y;x,y;x,y'."
        ),
    )
    return parser.parse_args()


def read_existing_backend() -> str:
    if not CONFIG_FILE.exists():
        return DEFAULT_BACKEND

    for line in CONFIG_FILE.read_text(encoding="utf-8").splitlines():
        if line.startswith("BIRDNET_BACKEND="):
            backend = line.split("=", 1)[1].strip()
            normalized = BACKEND_ALIASES.get(backend)
            if normalized is not None:
                return normalized

    return DEFAULT_BACKEND


def read_existing_input_mode() -> str:
    if not CONFIG_FILE.exists():
        return DEFAULT_INPUT_MODE

    for line in CONFIG_FILE.read_text(encoding="utf-8").splitlines():
        if line.startswith("BIRDNET_INPUT_MODE="):
            candidate = line.split("=", 1)[1].strip()
            if candidate in INPUT_MODE_CHOICES:
                return candidate

    return DEFAULT_INPUT_MODE


def read_existing_mic_positions() -> str:
    if not CONFIG_FILE.exists():
        return DEFAULT_MIC_POSITIONS_CM

    for line in CONFIG_FILE.read_text(encoding="utf-8").splitlines():
        if line.startswith("BIRDNET_MIC_POSITIONS_CM="):
            return line.split("=", 1)[1].strip()

    return DEFAULT_MIC_POSITIONS_CM


def validate_mic_positions(value: str) -> str:
    try:
        positions = [
            tuple(float(coordinate.strip()) for coordinate in pair.split(","))
            for pair in value.split(";")
        ]
    except ValueError as exc:
        raise SystemExit(
            "ERROR: --mic-positions-cm must use 'x,y;x,y;x,y;x,y' coordinates."
        ) from exc
    if (
        len(positions) != 4
        or any(len(position) != 2 for position in positions)
        or any(not math.isfinite(value) for position in positions for value in position)
    ):
        raise SystemExit(
            "ERROR: --mic-positions-cm must contain exactly four finite x,y coordinate pairs."
        )
    return value


def write_config(
    enabled: bool, backend: str, input_mode: str, mic_positions_cm: str
) -> None:
    backend = BACKEND_ALIASES[backend]
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(
        (
            f"BIRDNET_ENABLED={'1' if enabled else '0'}\n"
            f"BIRDNET_BACKEND={backend}\n"
            f"BIRDNET_INPUT_MODE={input_mode}\n"
            f"BIRDNET_MIC_POSITIONS_CM={mic_positions_cm}\n"
        ),
        encoding="utf-8",
    )


def missing_model_paths() -> list[Path]:
    required = [
        MODEL_ROOT / "audio-model.tflite",
        MODEL_ROOT / "labels" / "en_us.txt",
    ]
    return [path for path in required if not path.exists()]


def ensure_models_present() -> None:
    missing = [str(path) for path in missing_model_paths()]
    if not missing:
        return
    joined = "\n  ".join(missing)
    raise SystemExit(
        "ERROR: BirdNET model files are missing. Rerun ./install or ./upgrade with connectivity first.\n"
        f"  {joined}"
    )


def run_setup_step() -> None:
    if not SETUP_HELPER.exists():
        raise SystemExit(f"ERROR: missing BirdNET setup helper at {SETUP_HELPER}")
    result = subprocess.run(["sudo", str(SETUP_HELPER), "--verify-only"])
    if result.returncode != 0:
        raise SystemExit(result.returncode)


def systemctl(*args: str) -> None:
    result = subprocess.run(["sudo", "systemctl", *args])
    if result.returncode != 0:
        raise SystemExit(result.returncode)


def main() -> int:
    ensure_sensos_admin()
    args = parse_args()

    if args.disable:
        write_config(
            False,
            read_existing_backend(),
            read_existing_input_mode(),
            read_existing_mic_positions(),
        )
        systemctl("disable", "--now", SERVICE_NAME)
        print("BirdNET disabled.")
        return 0

    ensure_models_present()
    selected_backend = BACKEND_ALIASES[args.backend]
    mic_positions_cm = validate_mic_positions(
        args.mic_positions_cm or read_existing_mic_positions()
    )
    write_config(True, selected_backend, args.input_mode, mic_positions_cm)
    run_setup_step()

    if args.enable_service:
        systemctl("enable", SERVICE_NAME)
    if args.start_service:
        systemctl("start", SERVICE_NAME)

    print(
        "BirdNET configured. "
        f"Backend: {selected_backend}. Input mode: {args.input_mode}. Service: {SERVICE_NAME}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
