#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# Copyright (c) 2025 Rosalia Labs LLC

import argparse
import importlib.util
import os
import subprocess
import sys
from pathlib import Path

CLIENT_ROOT = Path(os.environ.get("SENSOS_CLIENT_ROOT", "/sensos"))
UTILS_FILE = CLIENT_ROOT / "libexec" / "utils.py"
CONFIG_FILE = CLIENT_ROOT / "etc" / "birdnet.env"
MODEL_ROOT = CLIENT_ROOT / "birdnet" / "BirdNET_v2.4_tflite"
SERVICE_NAME = "sensos-birdnet.service"
SETUP_HELPER = CLIENT_ROOT / "libexec" / "setup-birdnet.sh"
DEFAULT_BACKEND = "litert"
DEFAULT_INPUT_MODE = "split-channels"
BACKEND_ALIASES = {
    "tensorflow": "tensorflow",
    "litert": "litert",
    "tflite": "litert",
}
INPUT_MODE_CHOICES = ("mono", "split-channels")
DEFAULT_MIN_THRESHOLD = 0.0

if not UTILS_FILE.is_file():
    raise RuntimeError(f"Missing utils.py at {UTILS_FILE}")

UTILS_SPEC = importlib.util.spec_from_file_location("sensos_overlay_utils", UTILS_FILE)
UTILS_MODULE = importlib.util.module_from_spec(UTILS_SPEC)
assert UTILS_SPEC.loader is not None
UTILS_SPEC.loader.exec_module(UTILS_MODULE)

ensure_sensos_admin = UTILS_MODULE.ensure_sensos_admin


def probability(value: str) -> float:
    try:
        parsed = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("must be a number between 0 and 1") from exc
    if not 0.0 <= parsed <= 1.0:
        raise argparse.ArgumentTypeError("must be between 0 and 1")
    return parsed


def run(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, capture_output=True)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Configure optional host-native BirdNET processing."
    )
    parser.add_argument(
        "--disable",
        action="store_true",
        help="Disable BirdNET processing and stop the systemd service.",
    )
    parser.add_argument(
        "--enable-service",
        action="store_true",
        default=True,
        help="Enable sensos-birdnet.service after setup (default: true).",
    )
    parser.add_argument(
        "--start-service",
        action="store_true",
        help="Start sensos-birdnet.service after setup.",
    )
    parser.add_argument(
        "--backend",
        choices=["tensorflow", "litert", "tflite"],
        default=DEFAULT_BACKEND,
        help="BirdNET inference backend to install and require (default: litert).",
    )
    parser.add_argument(
        "--input-mode",
        choices=INPUT_MODE_CHOICES,
        default=DEFAULT_INPUT_MODE,
        help="How BirdNET should treat multichannel audio (default: split-channels).",
    )
    parser.add_argument(
        "--min-score",
        type=probability,
        help="Drop three-second intervals whose BirdNET score is below this value.",
    )
    parser.add_argument(
        "--min-likelihood",
        type=probability,
        help="Drop intervals whose location/date likelihood is below this value.",
    )
    parser.add_argument(
        "--min-volume",
        type=probability,
        help="Drop intervals whose normalized RMS volume is below this value.",
    )
    parser.add_argument(
        "--min-scoreXlikelihood",
        "--min-scorexlikelihood",
        dest="min_score_x_likelihood",
        type=probability,
        help="Drop intervals whose score multiplied by likelihood is below this value.",
    )
    return parser.parse_args()


def read_existing_backend() -> str:
    if not CONFIG_FILE.exists():
        return DEFAULT_BACKEND

    for line in CONFIG_FILE.read_text(encoding="utf-8").splitlines():
        if line.startswith("BIRDNET_BACKEND="):
            backend = line.split("=", 1)[1].strip()
            normalized = BACKEND_ALIASES.get(backend)
            if normalized is not None:
                return normalized

    return DEFAULT_BACKEND


def read_existing_input_mode() -> str:
    if not CONFIG_FILE.exists():
        return DEFAULT_INPUT_MODE

    for line in CONFIG_FILE.read_text(encoding="utf-8").splitlines():
        if line.startswith("BIRDNET_INPUT_MODE="):
            candidate = line.split("=", 1)[1].strip()
            if candidate in INPUT_MODE_CHOICES:
                return candidate

    return DEFAULT_INPUT_MODE


def read_existing_threshold(key: str) -> float:
    if not CONFIG_FILE.exists():
        return DEFAULT_MIN_THRESHOLD

    prefix = f"{key}="
    for line in CONFIG_FILE.read_text(encoding="utf-8").splitlines():
        if line.startswith(prefix):
            try:
                value = float(line.split("=", 1)[1].strip())
            except ValueError:
                return DEFAULT_MIN_THRESHOLD
            if 0.0 <= value <= 1.0:
                return value
            return DEFAULT_MIN_THRESHOLD
    return DEFAULT_MIN_THRESHOLD


def write_config(
    enabled: bool,
    backend: str,
    input_mode: str,
    min_score: float,
    min_likelihood: float,
    min_volume: float,
    min_score_x_likelihood: float,
) -> None:
    backend = BACKEND_ALIASES[backend]
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(
        (
            f"BIRDNET_ENABLED={'1' if enabled else '0'}\n"
            f"BIRDNET_BACKEND={backend}\n"
            f"BIRDNET_INPUT_MODE={input_mode}\n"
            f"BIRDNET_MIN_SCORE={min_score}\n"
            f"BIRDNET_MIN_LIKELIHOOD={min_likelihood}\n"
            f"BIRDNET_MIN_VOLUME={min_volume}\n"
            f"BIRDNET_MIN_SCORE_X_LIKELIHOOD={min_score_x_likelihood}\n"
        ),
        encoding="utf-8",
    )


def missing_model_paths() -> list[Path]:
    required = [
        MODEL_ROOT / "audio-model.tflite",
        MODEL_ROOT / "labels" / "en_us.txt",
    ]
    return [path for path in required if not path.exists()]


def ensure_models_present() -> None:
    missing = [str(path) for path in missing_model_paths()]
    if not missing:
        return
    joined = "\n  ".join(missing)
    raise SystemExit(
        "ERROR: BirdNET model files are missing. Rerun ./install or ./upgrade with connectivity first.\n"
        f"  {joined}"
    )


def run_setup_step() -> None:
    if not SETUP_HELPER.exists():
        raise SystemExit(f"ERROR: missing BirdNET setup helper at {SETUP_HELPER}")
    result = subprocess.run(["sudo", str(SETUP_HELPER), "--verify-only"])
    if result.returncode != 0:
        raise SystemExit(result.returncode)


def systemctl(*args: str) -> None:
    result = subprocess.run(["sudo", "systemctl", *args])
    if result.returncode != 0:
        raise SystemExit(result.returncode)


def main() -> int:
    ensure_sensos_admin()
    args = parse_args()

    if args.disable:
        write_config(
            False,
            read_existing_backend(),
            read_existing_input_mode(),
            read_existing_threshold("BIRDNET_MIN_SCORE"),
            read_existing_threshold("BIRDNET_MIN_LIKELIHOOD"),
            read_existing_threshold("BIRDNET_MIN_VOLUME"),
            read_existing_threshold("BIRDNET_MIN_SCORE_X_LIKELIHOOD"),
        )
        systemctl("disable", "--now", SERVICE_NAME)
        print("BirdNET disabled.")
        return 0

    ensure_models_present()
    selected_backend = BACKEND_ALIASES[args.backend]
    min_score = (
        args.min_score
        if args.min_score is not None
        else read_existing_threshold("BIRDNET_MIN_SCORE")
    )
    min_likelihood = (
        args.min_likelihood
        if args.min_likelihood is not None
        else read_existing_threshold("BIRDNET_MIN_LIKELIHOOD")
    )
    min_volume = (
        args.min_volume
        if args.min_volume is not None
        else read_existing_threshold("BIRDNET_MIN_VOLUME")
    )
    min_score_x_likelihood = (
        args.min_score_x_likelihood
        if args.min_score_x_likelihood is not None
        else read_existing_threshold("BIRDNET_MIN_SCORE_X_LIKELIHOOD")
    )
    write_config(
        True,
        selected_backend,
        args.input_mode,
        min_score,
        min_likelihood,
        min_volume,
        min_score_x_likelihood,
    )
    run_setup_step()

    if args.enable_service:
        systemctl("enable", SERVICE_NAME)
    if args.start_service:
        systemctl("start", SERVICE_NAME)

    print(
        "BirdNET configured. "
        f"Backend: {selected_backend}. Input mode: {args.input_mode}. "
        f"Minimum score: {min_score}. Minimum likelihood: {min_likelihood}. "
        f"Minimum volume: {min_volume}. "
        f"Minimum score×likelihood: {min_score_x_likelihood}. Service: {SERVICE_NAME}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
