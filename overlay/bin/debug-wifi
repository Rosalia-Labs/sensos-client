#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2025 Rosalia Labs LLC

set -euo pipefail

resolve_overlay_root() {
    printf '%s\n' "${SENSOS_CLIENT_ROOT:-/sensos}"
}

OVERLAY_ROOT="$(resolve_overlay_root)"
CLIENT_ROOT="${SENSOS_CLIENT_ROOT:-${OVERLAY_ROOT}}"
HOTSPOT_ENV_FILE="/etc/default/sensos-hotspot"
NETWORK_CONF="${CLIENT_ROOT}/etc/network.conf"
ACCESS_POINT_LOG="${CLIENT_ROOT}/log/access_point.log"
VERBOSE=false

have_cmd() {
    command -v "$1" >/dev/null 2>&1
}

print_usage() {
    cat <<EOF
Usage: debug-wifi [options]

Print a plain-language Wi-Fi status report.

Options:
  -v, --verbose  Include raw nmcli, iw, systemd, and log output
  -h, --help     Show this help and exit
EOF
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -v|--verbose)
                VERBOSE=true
                ;;
            -h|--help)
                print_usage
                exit 0
                ;;
            *)
                printf 'ERROR: unknown option: %s\n' "$1" >&2
                print_usage >&2
                exit 1
                ;;
        esac
        shift
    done
}

section() {
    printf '\n%s\n' "$*"
}

current_time() {
    date -Is 2>/dev/null || date '+%Y-%m-%dT%H:%M:%S%z'
}

run_block() {
    local label="$1"
    shift

    printf '\n$ %s\n' "$label"
    if "$@" 2>&1; then
        return 0
    fi
    printf '[command failed]\n'
    return 0
}

read_env_key() {
    local path="$1"
    local key="$2"

    [[ -f "${path}" ]] || return 0
    awk -F= -v wanted="${key}" '
        $1 == wanted {
            value = substr($0, length($1) + 2)
            gsub(/^'\''|'\''$/, "", value)
            gsub(/^"|"$/, "", value)
            print value
            exit
        }
    ' "${path}"
}

print_file_redacted() {
    local path="$1"

    if [[ ! -f "${path}" ]]; then
        printf 'not found: %s\n' "${path}"
        return 0
    fi

    sed -E \
        -e 's/^(HOTSPOT_PASSWORD=).*/\1[redacted]/' \
        -e 's/^(.*PASSWORD.*=).*/\1[redacted]/' \
        "${path}"
}

list_wifi_ifaces() {
    {
        if have_cmd nmcli; then
            { nmcli -t -f DEVICE,TYPE device status 2>/dev/null || true; } \
                | awk -F: '$2 == "wifi" && $1 != "" {print $1}'
        fi
        if have_cmd iw; then
            { iw dev 2>/dev/null || true; } | awk '$1 == "Interface" {print $2}'
        fi
        if have_cmd ip; then
            { ip -o link show 2>/dev/null || true; } \
                | awk -F': ' '$2 ~ /^wlan[0-9](@|:|$)/ {sub(/@.*/, "", $2); print $2}'
        fi
    } | sort -u
}

join_by_comma() {
    local first=true
    local item

    for item in "$@"; do
        if [[ "${first}" == true ]]; then
            printf '%s' "${item}"
            first=false
        else
            printf ', %s' "${item}"
        fi
    done
}

nm_device_value() {
    local field="$1"
    local iface="$2"

    have_cmd nmcli || return 0
    nmcli -g "${field}" device show "${iface}" 2>/dev/null | head -n 1 || true
}

nm_connection_value() {
    local field="$1"
    local con="$2"

    have_cmd nmcli || return 0
    [[ -n "${con}" && "${con}" != "--" ]] || return 0
    nmcli -g "${field}" connection show "${con}" 2>/dev/null | head -n 1 || true
}

iw_type() {
    local iface="$1"

    have_cmd iw || return 0
    iw dev "${iface}" info 2>/dev/null | awk '$1 == "type" {print $2; exit}'
}

iw_ssid() {
    local iface="$1"

    have_cmd iw || return 0
    iw dev "${iface}" info 2>/dev/null | awk '$1 == "ssid" {$1=""; sub(/^ /, ""); print; exit}'
}

connection_exists() {
    local con="$1"

    have_cmd nmcli || return 1
    nmcli -t -f NAME connection show 2>/dev/null | grep -Fxq "${con}"
}

connection_active() {
    local con="$1"

    have_cmd nmcli || return 1
    nmcli -t -f NAME connection show --active 2>/dev/null | grep -Fxq "${con}"
}

systemctl_value() {
    local kind="$1"
    local unit="$2"
    local result

    have_cmd systemctl || return 0
    case "${kind}" in
        enabled)
            result="$(systemctl is-enabled "${unit}" 2>/dev/null)" || true
            printf '%s' "${result:-not-found}"
            ;;
        active)
            result="$(systemctl is-active "${unit}" 2>/dev/null)" || true
            printf '%s' "${result:-inactive}"
            ;;
        sub)
            result="$(systemctl show -P SubState "${unit}" 2>/dev/null)" || true
            printf '%s' "${result:--}"
            ;;
    esac
}

wifi_radio_state() {
    have_cmd nmcli || {
        printf 'unknown'
        return 0
    }
    nmcli -t -f WIFI radio 2>/dev/null | head -n 1 || printf 'unknown'
}

rfkill_summary() {
    local output

    have_cmd rfkill || {
        printf 'unknown'
        return 0
    }
    output="$(rfkill list wifi 2>/dev/null || true)"
    if [[ -z "${output}" ]]; then
        printf 'unknown'
    elif grep -q 'Hard blocked: yes' <<<"${output}"; then
        printf 'hard-blocked'
    elif grep -q 'Soft blocked: yes' <<<"${output}"; then
        printf 'soft-blocked'
    else
        printf 'clear'
    fi
}

connection_line() {
    local con="$1"
    local label="$2"
    local exists="no"
    local active="no"
    local iface=""
    local mode=""
    local ssid=""
    local autoconnect=""

    if connection_exists "${con}"; then
        exists="yes"
        iface="$(nm_connection_value connection.interface-name "${con}")"
        mode="$(nm_connection_value 802-11-wireless.mode "${con}")"
        ssid="$(nm_connection_value 802-11-wireless.ssid "${con}")"
        autoconnect="$(nm_connection_value connection.autoconnect "${con}")"
        if connection_active "${con}"; then
            active="yes"
        fi
    fi

    if [[ "${exists}" == "no" ]]; then
        printf '  %-24s not configured\n' "${label}"
        return 0
    fi

    printf '  %-24s active=%-3s interface=%-7s mode=%-6s ssid=%s starts-on-boot=%s\n' \
        "${label}" "${active}" "${iface:---}" "${mode:---}" "${ssid:---}" "${autoconnect:---}"
}

iface_role() {
    local iface="$1"
    local connection="$2"
    local nm_mode="$3"
    local kernel_type="$4"

    if [[ "${kernel_type}" == "AP" || "${nm_mode}" == "ap" ]]; then
        printf 'hotspot'
    elif [[ "${kernel_type}" == "managed" || "${nm_mode}" == "infrastructure" ]]; then
        printf 'client'
    elif [[ -z "${connection}" || "${connection}" == "--" ]]; then
        printf 'idle'
    else
        printf 'unknown'
    fi
}

print_operator_summary() {
    local -a ifaces=("$@")
    local radio blocks hotspot_enabled hotspot_iface hotspot_ssid hotspot_unit_enabled hotspot_unit_active hotspot_unit_sub
    local iface connection nm_mode kernel_type ssid ip4 role iface_count active_hotspot=false client_count=0 idle_count=0 unknown_count=0
    local hotspot_target upstream_target

    radio="$(wifi_radio_state)"
    blocks="$(rfkill_summary)"
    hotspot_enabled="$(read_env_key "${HOTSPOT_ENV_FILE}" HOTSPOT_ENABLED)"
    hotspot_iface="$(read_env_key "${HOTSPOT_ENV_FILE}" HOTSPOT_INTERFACE)"
    hotspot_ssid="$(read_env_key "${HOTSPOT_ENV_FILE}" HOTSPOT_SSID)"
    hotspot_unit_enabled="$(systemctl_value enabled sensos-hotspot.service)"
    hotspot_unit_active="$(systemctl_value active sensos-hotspot.service)"
    hotspot_unit_sub="$(systemctl_value sub sensos-hotspot.service)"
    iface_count="${#ifaces[@]}"
    hotspot_target="${hotspot_iface:-wlan0}"
    upstream_target=""

    if ((${iface_count} > 0)); then
        local hotspot_found=false
        for iface in "${ifaces[@]}"; do
            if [[ "${iface}" == "${hotspot_target}" ]]; then
                hotspot_found=true
                break
            fi
        done
        if [[ "${hotspot_found}" != true ]]; then
            hotspot_target="${ifaces[0]}"
        fi
    fi

    for iface in "${ifaces[@]}"; do
        if [[ "${iface}" != "${hotspot_target}" ]]; then
            upstream_target="${iface}"
            break
        fi
    done
    if [[ -z "${upstream_target}" && ((${iface_count} > 0)) ]]; then
        upstream_target="${ifaces[0]}"
    fi

    if connection_active sensosap || connection_active sensos-hotspot; then
        active_hotspot=true
    fi

    printf 'SensOS Wi-Fi Check\n'
    printf '  host: %s\n' "$(hostname 2>/dev/null || printf unknown)"
    printf '  time: %s\n' "$(current_time)"
    printf '  radio: %s\n' "${radio}"
    printf '  rfkill: %s\n' "${blocks}"
    if ((${iface_count} == 0)); then
        printf '  interfaces: none detected\n'
    else
        printf '  interfaces: '
        join_by_comma "${ifaces[@]}"
        printf '\n'
    fi

    section "Hotspot"
    printf '  built-in startup hotspot: enabled=%s interface=%s ssid=%s\n' \
        "${hotspot_enabled:-unknown}" "${hotspot_iface:-unknown}" "${hotspot_ssid:-unknown}"
    printf '  startup service:          enabled=%s active=%s state=%s\n' \
        "${hotspot_unit_enabled:-unknown}" "${hotspot_unit_active:-unknown}" "${hotspot_unit_sub:-unknown}"
    connection_line sensosap "configured hotspot"
    connection_line sensos-hotspot "built-in hotspot"

    section "Interfaces"
    if ((${iface_count} == 0)); then
        printf '  No Wi-Fi interfaces were found by NetworkManager, iw, or ip.\n'
    fi

    for iface in "${ifaces[@]}"; do
        connection="$(nm_device_value GENERAL.CONNECTION "${iface}")"
        [[ -n "${connection}" ]] || connection="--"
        nm_mode="$(nm_connection_value 802-11-wireless.mode "${connection}")"
        kernel_type="$(iw_type "${iface}")"
        ssid="$(iw_ssid "${iface}")"
        ip4="$(nm_device_value IP4.ADDRESS "${iface}")"
        role="$(iface_role "${iface}" "${connection}" "${nm_mode}" "${kernel_type}")"

        case "${role}" in
            hotspot) active_hotspot=true ;;
            client) ((client_count += 1)) ;;
            idle) ((idle_count += 1)) ;;
            *) ((unknown_count += 1)) ;;
        esac

        printf '  %-7s role=%-8s connection=%-22s ssid=%-20s ip=%s\n' \
            "${iface}" "${role}" "${connection}" "${ssid:---}" "${ip4:---}"
    done

    section "Interpretation"
    if [[ "${radio}" == "disabled" ]]; then
        printf '  - Wi-Fi radio is off. Turn it on before hotspot or client Wi-Fi can work.\n'
    fi
    case "${blocks}" in
        soft-blocked)
            printf '  - Wi-Fi is soft-blocked. This is usually fixed with: sudo rfkill unblock wifi\n'
            ;;
        hard-blocked)
            printf '  - Wi-Fi is hard-blocked. Check hardware switch, USB adapter state, or platform firmware.\n'
            ;;
    esac

    if ((${iface_count} == 0)); then
        printf '  - No Wi-Fi device is visible to the OS. Check the Pi model, USB Wi-Fi adapter, and kernel logs.\n'
    elif ((${iface_count} == 1)); then
        printf '  - This is a single-radio system. It cannot reliably host a hotspot and join upstream Wi-Fi at the same time.\n'
        if ((client_count > 0)); then
            printf '  - The only Wi-Fi interface is in client mode, so a hotspot SSID will not be visible.\n'
        elif [[ "${active_hotspot}" == true ]]; then
            printf '  - The only Wi-Fi interface appears to be hosting a hotspot.\n'
        fi
    else
        printf '  - Multiple Wi-Fi interfaces are present. Prefer one for hotspot and one for upstream Wi-Fi.\n'
    fi

    if [[ "${active_hotspot}" != true ]]; then
        if connection_exists sensosap; then
            printf '  - A SensOS AP profile exists but is not active.\n'
        elif connection_exists sensos-hotspot; then
            printf '  - The bootstrap AP profile exists but is not active.\n'
        else
            printf '  - No active SensOS hotspot profile was found.\n'
        fi
    fi

    if [[ "${hotspot_enabled}" == "0" && "${hotspot_unit_enabled}" == "enabled" ]]; then
        printf '  - sensos-hotspot.service is enabled, but /etc/default/sensos-hotspot disables startup.\n'
    fi
    if ((unknown_count > 0)); then
        printf '  - One or more interfaces could not be classified from NetworkManager/iw state.\n'
    fi

    section "Hints"
    if ((${iface_count} == 0)); then
        printf '  - No Wi-Fi command can work until the OS sees a Wi-Fi interface.\n'
        printf '  - Check whether the USB adapter is seated, then run: debug-wifi --verbose\n'
    elif ((${iface_count} == 1)); then
        printf '  - Single-radio choice: use %s as a hotspot, or use it for upstream Wi-Fi, but not both.\n' "${ifaces[0]}"
        printf "  - To broadcast a setup hotspot: config-hotspot --interface %s --ssid sensos-setup --password '<8-63 character password>'\n" "${ifaces[0]}"
        printf "  - To join upstream Wi-Fi instead: config-wifi --iface %s --ssid '<network name>' --password '<password>' --replace-hotspot --start\n" "${ifaces[0]}"
    else
        printf '  - Two-radio setup available: keep hotspot on %s and use upstream Wi-Fi on %s.\n' "${hotspot_target}" "${upstream_target}"
        printf "  - Hotspot command: config-hotspot --interface %s --ssid sensos-setup --password '<8-63 character password>'\n" "${hotspot_target}"
        printf "  - Upstream Wi-Fi command: config-wifi --iface %s --ssid '<network name>' --password '<password>' --start\n" "${upstream_target}"
    fi
    if [[ "${active_hotspot}" != true && ((${iface_count} > 0)) ]]; then
        printf '  - No hotspot is active right now; phones/laptops will not see a SensOS SSID until hotspot mode starts.\n'
    fi
    if ((client_count > 0 && iface_count == 1)); then
        printf '  - The current Wi-Fi client connection explains why the hotspot is not visible on this single-radio device.\n'
    fi

    section "Next Steps"
    if [[ "${radio}" == "disabled" ]]; then
        printf '  sudo nmcli radio wifi on\n'
    fi
    if [[ "${blocks}" == "soft-blocked" ]]; then
        printf '  sudo rfkill unblock wifi\n'
    fi
    if [[ "${active_hotspot}" != true && ((${iface_count} > 0)) ]]; then
        printf "  config-hotspot --ssid sensos-setup --password '<8-63 character password>' --interface %s --channel 6\n" "${hotspot_iface:-wlan0}"
        if connection_exists sensosap; then
            printf '  sudo nmcli connection up sensosap\n'
        elif connection_exists sensos-hotspot; then
            printf '  sudo systemctl restart sensos-hotspot.service\n'
        fi
    fi
    printf '  debug-wifi --verbose   # include raw Linux/NetworkManager details for support\n'
}

print_verbose_report() {
    local -a ifaces=("$@")
    local iface

    section "Raw Tool Output"
    for cmd in nmcli iw rfkill ip systemctl journalctl; do
        if have_cmd "${cmd}"; then
            printf '%-10s present\n' "${cmd}"
        else
            printf '%-10s missing\n' "${cmd}"
        fi
    done

    if have_cmd nmcli; then
        run_block "nmcli radio" nmcli radio
        run_block "nmcli device status" nmcli device status
        run_block "nmcli active connections" nmcli -f NAME,TYPE,DEVICE connection show --active
        run_block "nmcli Wi-Fi connections" nmcli -f NAME,TYPE,DEVICE,AUTOCONNECT,AUTOCONNECT-PRIORITY connection show
        run_block "nmcli visible Wi-Fi scan" nmcli -f IN-USE,SSID,MODE,CHAN,RATE,SIGNAL,SECURITY,DEVICE device wifi list
        for profile in sensosap sensos-hotspot; do
            if connection_exists "${profile}"; then
                run_block "nmcli connection show ${profile}" \
                    nmcli -f connection.id,connection.interface-name,connection.autoconnect,connection.autoconnect-priority,802-11-wireless.mode,802-11-wireless.ssid,802-11-wireless.band,802-11-wireless.channel,ipv4.method connection show "${profile}"
            fi
        done
    fi
    if have_cmd rfkill; then
        run_block "rfkill list wifi" rfkill list wifi
    fi
    if have_cmd iw; then
        run_block "iw reg get" iw reg get
        for iface in "${ifaces[@]}"; do
            run_block "iw dev ${iface} info" iw dev "${iface}" info
            run_block "iw dev ${iface} link" iw dev "${iface}" link
            run_block "iw dev ${iface} station dump" iw dev "${iface}" station dump
        done
    fi
    if have_cmd ip; then
        for iface in "${ifaces[@]}"; do
            run_block "ip addr show ${iface}" ip addr show "${iface}"
        done
    fi
    if have_cmd systemctl; then
        run_block "systemctl status sensos-hotspot.service" systemctl --no-pager --full status sensos-hotspot.service
    fi

    section "SensOS Files"
    print_file_redacted "${HOTSPOT_ENV_FILE}"
    print_file_redacted "${NETWORK_CONF}"

    section "Recent Logs"
    if [[ -f "${ACCESS_POINT_LOG}" ]]; then
        run_block "tail -n 80 ${ACCESS_POINT_LOG}" tail -n 80 "${ACCESS_POINT_LOG}"
    else
        printf 'not found: %s\n' "${ACCESS_POINT_LOG}"
    fi
    if have_cmd journalctl; then
        run_block "journalctl -u sensos-hotspot.service -b -n 80" journalctl -u sensos-hotspot.service -b -n 80 --no-pager
        run_block "journalctl -u NetworkManager -b -n 120" journalctl -u NetworkManager -b -n 120 --no-pager
    fi
}

main() {
    local -a ifaces=()

    parse_args "$@"
    mapfile -t ifaces < <(list_wifi_ifaces)
    print_operator_summary "${ifaces[@]}"

    if [[ "${VERBOSE}" == true ]]; then
        print_verbose_report "${ifaces[@]}"
    fi
}

main "$@"
