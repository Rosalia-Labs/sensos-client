#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# Schedules a day/night uplink bandwidth cap via tc (sensos-uplink-cap.timer
# + apply-uplink-cap.sh), on top of the manual one-off cap config-wifi
# already supports. Useful on a shared uplink (e.g. a field station's wifi)
# where other users need full bandwidth during the day but the device can
# safely drain its upload backlog overnight.
#
# Both the safe bandwidth number and the quiet-hours window are site-specific
# -- there is no universal default here, deliberately: a guessed cap is
# either too loose (still interferes) or too tight (useless), and only
# someone at the site can judge which.

set -euo pipefail

SCRIPT_FILE="$(realpath "${BASH_SOURCE[0]}")"
resolve_overlay_root() {
    printf '%s\n' "${SENSOS_CLIENT_ROOT:-/sensos}"
}

OVERLAY_ROOT="$(resolve_overlay_root)"
CLIENT_ROOT="${SENSOS_CLIENT_ROOT:-${OVERLAY_ROOT}}"
script_name="$(basename "$0")"
PARSE_SWITCHES_LIB="${OVERLAY_ROOT}/libexec/parse-switches.sh"
SENSOS_ADMIN_HELPER_LIB="${OVERLAY_ROOT}/libexec/ensure-sensos-admin.sh"
TC_UPLINK_LIB="${OVERLAY_ROOT}/libexec/tc-uplink.sh"
APPLY_SCRIPT="${OVERLAY_ROOT}/libexec/apply-uplink-cap.sh"
WIFI_CONF="${OVERLAY_ROOT}/etc/wifi.conf"

[[ -f "${PARSE_SWITCHES_LIB}" ]] || {
    echo "Missing parse-switches library at ${PARSE_SWITCHES_LIB}" >&2
    exit 1
}
source "${PARSE_SWITCHES_LIB}"
[[ -f "${SENSOS_ADMIN_HELPER_LIB}" ]] || {
    echo "Missing sensos-admin helper at ${SENSOS_ADMIN_HELPER_LIB}" >&2
    exit 1
}
source "${SENSOS_ADMIN_HELPER_LIB}"
[[ -f "${TC_UPLINK_LIB}" ]] || {
    echo "Missing tc-uplink library at ${TC_UPLINK_LIB}" >&2
    exit 1
}
source "${TC_UPLINK_LIB}"

ensure_sensos_admin_user "${SCRIPT_FILE}" "$@"

config_path="${CLIENT_ROOT}/etc/uplink-cap.conf"
mkdir -p "${CLIENT_ROOT}/etc"

register_option --iface iface "Uplink interface to cap (default: read UPLINK_INTERFACE from wifi.conf)" ""
register_option --day-start-hour day_start_hour "Local hour (0-23) the day/busy cap starts" ""
register_option --day-end-hour day_end_hour "Local hour (0-23) the day/busy cap ends (night cap applies outside this window)" ""
register_option --day-limit-up-kbit day_limit_up_kbit "Egress cap during the day window, in kbit/sec (blank=uncapped)" ""
register_option --day-limit-down-kbit day_limit_down_kbit "Ingress cap during the day window, in kbit/sec (blank=uncapped)" ""
register_option --night-limit-up-kbit night_limit_up_kbit "Egress cap outside the day window, in kbit/sec (blank=uncapped)" ""
register_option --night-limit-down-kbit night_limit_down_kbit "Ingress cap outside the day window, in kbit/sec (blank=uncapped)" ""
register_option --disable disable "Disable uplink cap scheduling and clear any applied tc limits" "false"

parse_switches "${script_name}" "$@"

require_hour() {
    local value="$1"
    local option_name="$2"
    [[ -z "${value}" ]] && return 0
    [[ "${value}" =~ ^[0-9]+$ ]] && ((value >= 0 && value <= 23)) || {
        echo "ERROR: ${option_name} must be an integer hour 0-23, got '${value}'." >&2
        exit 1
    }
}

resolve_iface() {
    if [[ -n "${iface}" ]]; then
        printf '%s\n' "${iface}"
        return 0
    fi
    if [[ -f "${WIFI_CONF}" ]]; then
        # shellcheck disable=SC1090
        source "${WIFI_CONF}"
        if [[ -n "${UPLINK_INTERFACE:-}" ]]; then
            printf '%s\n' "${UPLINK_INTERFACE}"
            return 0
        fi
    fi
    echo "ERROR: could not determine uplink interface. Pass --iface, or configure one first with config-wifi." >&2
    exit 1
}

if [[ "${disable}" == "true" ]]; then
    resolved_iface="$(resolve_iface)"
    echo "Disabling uplink cap scheduling and clearing tc limits on ${resolved_iface}..."
    rm -f "${config_path}"
    sudo systemctl disable --now sensos-uplink-cap.timer 2>/dev/null || true
    clear_tc_limits "${resolved_iface}"
    echo "Done."
    exit 0
fi

require_hour "${day_start_hour}" "--day-start-hour"
require_hour "${day_end_hour}" "--day-end-hour"

if [[ -n "${day_start_hour}" || -n "${day_end_hour}" ]] && [[ -z "${day_start_hour}" || -z "${day_end_hour}" ]]; then
    echo "ERROR: --day-start-hour and --day-end-hour must be given together." >&2
    exit 1
fi

resolved_iface="$(resolve_iface)"

{
    echo "# Auto-generated by ${script_name}"
    echo "# Bandwidth numbers and the day/night boundary are site-specific --"
    echo "# re-run config-uplink-cap on this device to change them."
    echo "IFACE=${resolved_iface}"
    echo "DAY_START_HOUR=${day_start_hour}"
    echo "DAY_END_HOUR=${day_end_hour}"
    echo "DAY_LIMIT_UP_KBIT=${day_limit_up_kbit}"
    echo "DAY_LIMIT_DOWN_KBIT=${day_limit_down_kbit}"
    echo "NIGHT_LIMIT_UP_KBIT=${night_limit_up_kbit}"
    echo "NIGHT_LIMIT_DOWN_KBIT=${night_limit_down_kbit}"
} >"${config_path}"

echo "Wrote config to ${config_path}:"
cat "${config_path}"

sudo systemctl daemon-reload
sudo systemctl enable --now sensos-uplink-cap.timer

echo "Applying current cap immediately (not waiting for the first timer tick)..."
sudo "${APPLY_SCRIPT}"

echo "Done. sensos-uplink-cap.timer will re-check every 10 minutes."
