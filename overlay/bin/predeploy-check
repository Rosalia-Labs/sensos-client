#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# Copyright (c) 2025 Rosalia Labs LLC

"""Bench-stage pre-deploy check: run this on a unit that's built but not yet
deployed in the field. Reports what hardware was observed and what manual
checks have been confirmed -- it does not pass/fail the unit, since valid
hardware configurations vary across the fleet. Read the report and judge
against what this specific unit is supposed to have.
"""

import importlib.util
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

OVERLAY_ROOT = Path(os.environ.get("SENSOS_CLIENT_ROOT", "/sensos"))
CHECKS_FILE = OVERLAY_ROOT / "libexec" / "predeploy_checks.py"

if not CHECKS_FILE.is_file():
    raise SystemExit(f"missing dependency: {CHECKS_FILE}")


def _load(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec)
    assert spec.loader is not None
    spec.loader.exec_module(module)
    return module


PC = _load("sensos_predeploy_checks", CHECKS_FILE)


AUTOMATED_CHECKS = [
    ("bootstrap user password", "bootstrap_user_password", PC.check_bootstrap_user_password),
    ("bootstrap hotspot default", "bootstrap_hotspot_default", PC.check_bootstrap_hotspot_default),
    ("network registration", "network_config", PC.check_network_config),
    ("audio hardware", "audio_hardware", PC.check_audio_hardware_present),
    ("I2C bus", "i2c_bus", PC.check_i2c_bus),
    ("TEROS serial sensor", "teros_serial", PC.check_teros_serial),
    ("GPS fix", "gps_fix", PC.check_gps_fix),
    ("uplink Wi-Fi intent", "uplink_intent", PC.check_uplink_intent),
    ("local AP intent", "hotspot_intent", PC.check_hotspot_intent),
    ("audio listening reminder", "audio_listen", PC.check_audio_listen),
]


def run_paged(func):
    """Run `func` with stdout redirected through a pager -- this report is
    long enough that the start scrolls off before the end prints. Only
    kicks in when stdout is actually a terminal: piping into a file or
    another command (`predeploy-check > report.txt`) must see the same
    plain output as before, which `isatty()` already distinguishes.
    Respects $PAGER if set, otherwise `less -FRX` (quit automatically if
    the output fits on one screen, don't clear the screen on exit so the
    report stays in scrollback afterward).
    """
    if not sys.stdout.isatty():
        return func()

    pager_cmd = shlex.split(os.environ.get("PAGER") or "less -FRX")
    if not shutil.which(pager_cmd[0]):
        return func()

    pager = subprocess.Popen(pager_cmd, stdin=subprocess.PIPE, text=True)
    original_stdout = sys.stdout
    try:
        sys.stdout = pager.stdin
        return func()
    finally:
        sys.stdout = original_stdout
        try:
            pager.stdin.close()
        except (BrokenPipeError, OSError):
            pass
        pager.wait()


def main() -> int:
    state = PC.load_state()

    for title, name, check_fn in AUTOMATED_CHECKS:
        print(f"== {title} ==")
        status, detail = check_fn()
        entry = PC.record_result(state, name, status, detail)
        print(PC.report_line(name, entry))
        print()

    PC.save_state(state)

    print()
    print(f"Full state recorded in {PC.STATE_FILE}")
    print()
    print("== pre-deploy check summary ==")
    for name, entry in sorted(state.items()):
        print(PC.report_line(name, entry))

    print()
    print("== config-* invocation history ==")
    print("When each config-* script on this unit was last run, regardless of")
    print("whether it has a dedicated check above -- 'never' doesn't mean wrong,")
    print("just that the operator should confirm it's intentional for this unit.")
    print("Also: on a unit provisioned before this tracking existed, 'never' can")
    print("mean 'ran before anything recorded it', not 'never run at all' -- check")
    print("the stored config state below, which reflects actual values regardless")
    print("of when they were set.")
    for name, status in PC.list_config_invocations():
        print(f"{name}: {status}")

    print()
    print("== stored config state (/sensos/etc/*.conf) ==")
    print("What's actually on disk right now, independent of the invocation")
    print("history above -- a script can run without setting a value, or a")
    print("file can be edited outside any config-* script entirely.")
    for filename, values, raw_text in PC.list_stored_config_state():
        print(f"-- {filename} --")
        if values:
            for key, value in sorted(values.items()):
                print(f"  {key}={value}")
        elif raw_text.strip():
            # Not this project's own key=value format (e.g. chrony.conf,
            # nftables.conf have their own directive syntax) -- show the
            # real content rather than report it as empty.
            for line in raw_text.splitlines():
                print(f"  {line}")
        else:
            print("  (empty)")

    print()
    print("=" * 60)
    print("REMINDER: listen to this unit's audio before deployment.")
    print("See the 'audio listening reminder' output above.")
    print()
    # This prints regardless of what the bootstrap_user_password check
    # above concluded -- including when it's not_checked (no tool on this
    # system could verify it). That check depends on external tools being
    # present and correct, confirmed twice already to be fallible in ways
    # that weren't obvious beforehand; a standing reminder that doesn't
    # assert any specific current state is never wrong to print, where a
    # confident claim based on an unreliable check could be.
    print("REMINDER: confirm the bootstrap user's password has been changed")
    print("from this fleet's documented default before deployment, regardless")
    print("of what the 'bootstrap user password' check above found.")
    print("=" * 60)

    return 0


if __name__ == "__main__":
    sys.exit(run_paged(main))
