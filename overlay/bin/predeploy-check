"""Bench-stage pre-deploy check: run this on a unit that's built but not yet
deployed in the field. Reports what hardware was observed and what manual
checks have been confirmed -- it does not pass/fail the unit, since valid
hardware configurations vary across the fleet. Read the report and judge
against what this specific unit is supposed to have.
"""

import importlib.util
import os
import sys
from pathlib import Path

OVERLAY_ROOT = Path(os.environ.get("SENSOS_CLIENT_ROOT", "/sensos"))
CHECKS_FILE = OVERLAY_ROOT / "libexec" / "predeploy_checks.py"

if not CHECKS_FILE.is_file():
    raise SystemExit(f"missing dependency: {CHECKS_FILE}")


def _load(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec)
    assert spec.loader is not None
    spec.loader.exec_module(module)
    return module


PC = _load("sensos_predeploy_checks", CHECKS_FILE)


AUTOMATED_CHECKS = [
    ("bootstrap user password", "bootstrap_user_password", PC.check_bootstrap_user_password),
    ("bootstrap hotspot default", "bootstrap_hotspot_default", PC.check_bootstrap_hotspot_default),
    ("network registration", "network_config", PC.check_network_config),
    ("audio hardware", "audio_hardware", PC.check_audio_hardware_present),
    ("I2C bus", "i2c_bus", PC.check_i2c_bus),
    ("TEROS serial sensor", "teros_serial", PC.check_teros_serial),
    ("GPS fix", "gps_fix", PC.check_gps_fix),
    ("uplink Wi-Fi intent", "uplink_intent", PC.check_uplink_intent),
    ("local AP intent", "hotspot_intent", PC.check_hotspot_intent),
]


def main() -> int:
    state = PC.load_state()

    for title, name, check_fn in AUTOMATED_CHECKS:
        print(f"== {title} ==")
        status, detail = check_fn()
        entry = PC.record_result(state, name, status, detail)
        print(PC.report_line(name, entry))
        print()

    print("== audio listening test ==")
    status, detail = PC.check_audio_listen(state)
    entry = PC.record_result(state, "audio_listen", status, detail)
    print(PC.report_line("audio_listen", entry))

    PC.save_state(state)

    print()
    print(f"Full state recorded in {PC.STATE_FILE}")
    print()
    print("== pre-deploy check summary ==")
    for name, entry in sorted(state.items()):
        print(PC.report_line(name, entry))

    print()
    print("== config-* invocation history ==")
    print("When each config-* script on this unit was last run, regardless of")
    print("whether it has a dedicated check above -- 'never' doesn't mean wrong,")
    print("just that the operator should confirm it's intentional for this unit.")
    for name, status in PC.list_config_invocations():
        print(f"{name}: {status}")

    print()
    print("== stored config state (/sensos/etc/*.conf) ==")
    print("What's actually on disk right now, independent of the invocation")
    print("history above -- a script can run without setting a value, or a")
    print("file can be edited outside any config-* script entirely.")
    for filename, values in PC.list_stored_config_state():
        print(f"-- {filename} --")
        if values:
            for key, value in sorted(values.items()):
                print(f"  {key}={value}")
        else:
            print("  (empty or unparsed)")

    return 0


if __name__ == "__main__":
    sys.exit(main())
