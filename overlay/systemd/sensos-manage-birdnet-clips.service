[Unit]
Description=Upload and thin BirdNET labeled audio clips
OnFailure=sensos-report-failure@%n.service
After=sensos-record-audio.service sensos-compress-audio.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=sensos-runner
Group=sensos-data
UMask=0002
LoadCredential=api_password:/sensos/keys/api_password
ExecStart=/sensos/python/venv/bin/python /sensos/libexec/manage-birdnet-clips.py
WorkingDirectory=/sensos/data
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
