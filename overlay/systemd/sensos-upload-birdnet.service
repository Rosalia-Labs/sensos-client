[Unit]
Description=Upload BirdNET results to server
OnFailure=sensos-report-failure@%n.service

[Service]
Type=simple
User=sensos-runner
Group=sensos-data
UMask=0002
LoadCredential=api_password:/sensos/keys/api_password
ExecStart=/sensos/python/venv/bin/python /sensos/libexec/upload-birdnet-results.py
WorkingDirectory=/sensos/data
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
