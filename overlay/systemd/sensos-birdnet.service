[Unit]
Description=Run BirdNET over compressed FLAC inputs and emit FLAC label runs
OnFailure=sensos-report-failure@%n.service
After=sensos-compress-audio.service
StartLimitIntervalSec=300
StartLimitBurst=5

# This service is optional. It also requires:
# - BirdNET model files under /sensos/birdnet/BirdNET_v2.4_tflite
# - host-native Python deps from python/requirements-birdnet.txt

[Service]
Type=simple
User=sensos-runner
Group=sensos-data
UMask=0002
ExecStart=/sensos/python/birdnet-venv/bin/python /sensos/libexec/process-birdnet.py
WorkingDirectory=/sensos/data
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
