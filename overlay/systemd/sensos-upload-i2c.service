[Unit]
Description=Upload I2C readings to server

[Service]
Type=simple
User=sensos-runner
Group=sensos-data
UMask=0002
LoadCredential=api_password:/sensos/keys/api_password
ExecStart=/sensos/python/venv/bin/python /sensos/libexec/upload-i2c-readings.py
WorkingDirectory=/sensos/data
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
