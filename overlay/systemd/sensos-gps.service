[Unit]
Description=Read GPS fix data and update device location
After=gpsd.service
OnFailure=sensos-report-failure@%n.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=sensos-runner
Group=sensos-data
UMask=0002
NoNewPrivileges=true
LoadCredential=api_password:/sensos/keys/api_password
ExecStart=/sensos/python/venv/bin/python /sensos/libexec/sensos-gps.py
WorkingDirectory=/sensos/data
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
